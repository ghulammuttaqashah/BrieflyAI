{
  "manifest_version": 3,
  "name": "BrieflyAI",
  "version": "1.0.0",
  "description": "Read less, understand more with AI-powered article summaries.",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "tabs"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open BrieflyAI", "default_popup": "popup.html", "default_icon": {"16": "icons.png", "32": "icons.png", "48": "icons.png", "128": "icons.png"}},
  "icons": {"16": "icons.png", "32": "icons.png", "48": "icons.png", "128": "icons.png"},
  "side_panel": {"default_path": "sidepanel.html"},
  "options_ui": {"page": "options.html", "open_in_tab": true}
}
